{
  "name": "明代御案 / Ming Imperial Desk",
  "version": "0.1",
  "description": "第一版策略游戏 UI 的颜色、间距和圆角令牌。界面组件只引用令牌，不要在每个场景里随意写新颜色。",
  "colors": {
    "paper": "#F4E9D8",
    "paperDark": "#E2D0B5",
    "ink": "#2B1F1A",
    "inkMuted": "#66574B",
    "vermilion": "#A33A2E",
    "vermilionBright": "#C64A3B",
    "jade": "#3C6B64",
    "jadeBright": "#6A9A8B",
    "gold": "#B59047",
    "danger": "#8C2F39",
    "mapNight": "#18232A",
    "mapLand": "#334A45",
    "mapWater": "#132B38"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "typography": {
    "title": { "size": 30, "weight": 700 },
    "heading": { "size": 20, "weight": 700 },
    "body": { "size": 16, "weight": 400 },
    "caption": { "size": 13, "weight": 400 },
    "numeric": { "size": 18, "weight": 700 }
  },
  "shape": {
    "panelRadius": 6,
    "buttonRadius": 4,
    "borderWidth": 1,
    "focusWidth": 2
  }
}
