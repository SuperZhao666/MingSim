# Deterministic map builders emit LF.  Keep only their text artifacts pinned so
# a Windows checkout remains byte-clean after a fresh rebuild.  The UI asset
# ledger (regenerated by tools/ui/ming_ui_assets.py snapshot-ledger) must also
# stay LF: global core.autocrlf=true would otherwise give it CRLF in the working
# tree and a rebuild would flip the bytes back to LF, dirtying git status.
assets/maps/generated/**/*.json text eol=lf
assets/maps/generated/**/*.geojson text eol=lf
assets/ui/generated/**/*.json text eol=lf
