<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 与 Ming.Persistence 同步：仅在联网环境（CI）或显式启用时编译 SQLite 验收 -->
    <MingSimEnableSqliteStore Condition="'$(MingSimEnableSqliteStore)' == '' and '$(GITHUB_ACTIONS)' == 'true'">true</MingSimEnableSqliteStore>
    <MingSimEnableSqliteStore Condition="'$(MingSimEnableSqliteStore)' == ''">false</MingSimEnableSqliteStore>
    <DefineConstants Condition="'$(MingSimEnableSqliteStore)' == 'true'">$(DefineConstants);MINGSIM_SQLITE_STORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ming.Application\Ming.Application.csproj" />
    <ProjectReference Include="..\..\src\Ming.Domain\Ming.Domain.csproj" />
    <ProjectReference Include="..\..\src\Ming.Persistence\Ming.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Ming.Simulation\Ming.Simulation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SqliteStoreAcceptance.cs" Condition="'$(MingSimEnableSqliteStore)' != 'true'" />
  </ItemGroup>
</Project>
